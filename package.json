{
  "name": "insta-ai-autopost",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Turn story scripts into AI videos with Runway and post them to Instagram daily.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "post": "node --env-file-if-exists=.env src/index.js",
    "dry-run": "node --env-file-if-exists=.env src/index.js --dry-run",
    "whoami": "node --env-file-if-exists=.env src/whoami.js",
    "refresh-token": "node --env-file-if-exists=.env src/refresh-token.js",
    "validate": "node --env-file-if-exists=.env src/validate.js",
    "telugu": "node --env-file-if-exists=.env src/telugu.js",
    "dashboard": "node --env-file-if-exists=.env src/dashboard.js",
    "cards": "node --env-file-if-exists=.env src/cards.js",
    "engage": "node --env-file-if-exists=.env src/engage.js",
    "scripts-sheet": "node src/scripts-sheet.js",
    "voice-sync": "node src/scripts-sheet.js && git add assets/voice/own telugu-stories/SCRIPTS.md && (git diff --cached --quiet && echo 'No new recordings.' || (git commit -q -m 'Add voice recordings' && git pull --rebase -q && git push -q && echo 'Recordings uploaded \u2014 they will be used automatically.'))",
    "youtube-auth": "node src/youtube-auth.js",
    "deals-page": "node src/deals-page.js"
  },
  "dependencies": {
    "@runwayml/sdk": "^3.0.0",
    "ffmpeg-static": "^5.2.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
