# Copy to .env and fill in. Never commit .env.

# Runway API key from https://dev.runwayml.com (API credits are separate from a Runway app subscription)
RUNWAYML_API_SECRET=

# Long-lived Instagram token: Meta app dashboard > Instagram > API setup with Instagram login > Generate token
IG_ACCESS_TOKEN=
# Run `npm run whoami` after setting the token to get this value
IG_USER_ID=

# Optional
# RUNWAY_MODEL=veo3.1_fast        # veo3.1_fast | veo3.1 | gen4.5
# RUNWAY_RATIO=720:1280           # vertical; veo also supports 1080:1920
# IG_GRAPH_HOST=graph.instagram.com  # use graph.facebook.com if your app uses Facebook Login
# IG_API_VERSION=v25.0
